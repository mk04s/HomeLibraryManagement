{% extends 'base.html.jinja' %}

{% block title %}{{ book.title }} - Szczegóły - Biblioteka Domowa{% endblock %}

{% block content %}
<div class="py-8 max-w-4xl mx-auto">
    <div class="mb-6">
        <a href="{% url 'manage_books:index' %}" class="inline-flex items-center text-slate-600 hover:text-amber-500 transition font-medium">
            ← Powrót do listy książek
        </a>
    </div>

    <div class="bg-white rounded-lg shadow-md border border-slate-100 overflow-hidden">
        <div class="p-8">
            <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
                <div>
                    <h1 class="text-3xl font-bold text-slate-800 mb-2">{{ book.title }}</h1>
                    <p class="text-lg text-slate-600">
                        <strong>Autor:</strong> 
                        {% for author in book.authors.all %}
                            {{ author }}{% if not forloop.last %}, {% endif %}
                        {% empty %}
                            <span class="text-slate-400 italic">Brak autora</span>
                        {% endfor %}
                    </p>
                </div>
                <div class="flex gap-2">
                    {% if book.is_favorite %}
                        <span class="bg-red-100 text-red-700 px-3 py-1 rounded-full text-xs font-bold">♥ Ulubiona</span>
                    {% endif %}
                    {% if book.is_read %}
                        <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-xs font-bold">✓ Przeczytana</span>
                    {% else %}
                        <span class="bg-amber-100 text-amber-700 px-3 py-1 rounded-full text-xs font-bold">⏱ Do przeczytania</span>
                    {% endif %}
                </div>
            </div>

            <hr class="border-slate-100 mb-6">

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                <div>
                    <h3 class="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-3">Informacje o wydaniu</h3>
                    <table class="w-full text-sm">
                        <tr class="border-b border-slate-50">
                            <td class="py-2 text-slate-500 font-medium">Wydawca:</td>
                            <td class="py-2 text-slate-800 font-semibold">{{ book.publisher }}</td>
                        </tr>
                        <tr class="border-b border-slate-50">
                            <td class="py-2 text-slate-500 font-medium">Data publikacji:</td>
                            <td class="py-2 text-slate-800">{{ book.publication_date|date:"Y-m-d" }}</td>
                        </tr>
                        <tr class="border-b border-slate-50">
                            <td class="py-2 text-slate-500 font-medium">Seria wydawnicza:</td>
                            <td class="py-2 text-slate-800">
                                {{ book.series|default:"<span class='text-slate-400 italic'>Nie należy do serii</span>" }}
                            </td>
                        </tr>
                    </table>
                </div>

                <div>
                    <h3 class="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-3">Specyfikacja techniczna</h3>
                    <table class="w-full text-sm">
                        <tr class="border-b border-slate-50">
                            <td class="py-2 text-slate-500 font-medium">ISBN:</td>
                            <td class="py-2 text-slate-800 font-mono">{{ book.isbn }}</td>
                        </tr>
                        <tr class="border-b border-slate-50">
                            <td class="py-2 text-slate-500 font-medium">Liczba stron:</td>
                            <td class="py-2 text-slate-800">{{ book.pages }}</td>
                        </tr>
                        <tr class="border-b border-slate-50">
                            <td class="py-2 text-slate-500 font-medium">Format / Okładka:</td>
                            <td class="py-2 text-slate-800">{{ book.get_cover_display|default:book.cover }}</td>
                        </tr>
                        <tr class="border-b border-slate-50">
                            <td class="py-2 text-slate-500 font-medium">Język:</td>
                            <td class="py-2 text-slate-800">{{ book.get_language_display|default:book.language }}</td>
                        </tr>
                    </table>
                </div>
            </div>

            <div class="mb-8">
                <h3 class="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-3">Gatunki i Tematyka</h3>
                <div class="flex flex-wrap gap-2 mb-2">
                    {% for genre in book.genres.all %}
                        <span class="bg-slate-100 text-slate-700 px-3 py-1 rounded text-xs font-medium"># {{ genre.name }}</span>
                    {% endfor %}
                </div>
                <div class="flex flex-wrap gap-2">
                    {% for topic in book.topics.all %}
                        <span class="bg-blue-50 text-blue-700 px-3 py-1 rounded text-xs font-medium">💡 {{ topic.name }}</span>
                    {% endfor %}
                </div>
            </div>

            <div>
                <h3 class="text-lg font-bold text-slate-800 mb-4 flex items-center gap-2">
                    📝 Twoje notatki do książki
                </h3>
                
                {% for note in book.note_set.all %}
                    <div class="bg-slate-50 border-l-4 border-slate-700 p-4 rounded-r mb-3">
                        <p class="text-slate-700 text-sm whitespace-pre-line">{{ note.content }}</p>
                        <span class="text-slate-400 text-xs block mt-2">{{ note.created_at|date:"d.m.Y H:i" }}</span>
                    </div>
                {% empty %}
                    <div class="bg-slate-50 text-slate-500 p-4 rounded text-sm italic text-center">
                        Nie dodałeś jeszcze żadnych notatek do tej książki. możesz to zrobić w panelu admina!
                    </div>
                {% endfor %}
            </div>

        </div>
    </div>
</div>
{% endblock %}
