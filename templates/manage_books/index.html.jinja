{% extends 'base.html.jinja' %}

{% block title %}Strona Główna - Biblioteka Domowa{% endblock %}

{% block content %}
<div class="py-8">
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold text-slate-800">Twoje Książki</h1>
        <span class="bg-amber-400 text-slate-800 px-3 py-1 rounded-full font-semibold text-sm">
            Łącznie: {{ books|length }}
        </span>
    </div>

    {% if books %}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            
            {% for book in books %}
                <div class="bg-white rounded-lg shadow-md p-6 border border-slate-100 hover:shadow-xl transition flex flex-col justify-between">
                    <div>
                        <h2 class="text-xl font-bold text-slate-800 mb-2">{{ book.title }}</h2>
                        
                        <p class="text-slate-600 mb-1">
                            <strong>Autor:</strong> 
                            {% for author in book.authors.all %}
                                {{ author }}{% if not forloop.last %}, {% endif %}
                            {% endfor %}
                        </p>
                        <p class="text-slate-600 mb-4 text-sm">
                            <strong>Gatunek:</strong> 
                            {% for genre in book.genres.all %}
                                {{ genre }}{% if not forloop.last %}, {% endif %}
                            {% endfor %}
                        </p>
                    </div>
                    
                    <div class="mt-4">
                        <a href="{% url 'manage_books:book' book.id %}" class="inline-block bg-slate-800 text-white px-4 py-2 rounded hover:bg-amber-500 hover:text-slate-900 transition">
                            Zobacz szczegóły
                        </a>
                    </div>
                </div>
            {% endfor %}
            
        </div>
    {% else %}
        <div class="bg-white rounded-lg shadow p-8 text-center border border-slate-100">
            <p class="text-slate-600 text-lg">Twoja biblioteka jest jeszcze pusta. Czas dodać pierwsze zbiory!</p>
        </div>
    {% endif %}
</div>
{% endblock %}