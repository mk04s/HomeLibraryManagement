{% extends 'base.html.jinja' %}

{% block title %}Autorzy - Biblioteka Domowa{% endblock %}

{% block content %}
<div class="py-8 text-slate-800">
    <h1 class="text-3xl font-bold mb-8">Nasi Autorzy</h1>

    <div class="bg-white rounded-lg shadow-md border border-slate-100 overflow-hidden">
        <ul class="divide-y divide-slate-100">
            {% for author in authors %}
                <li class="p-4 flex justify-between items-center hover:bg-slate-50 transition">
                    <div>
                        <span class="font-semibold text-lg text-slate-700">{{ author }}</span>
                        <span class="text-sm text-slate-400 ml-2">({{ author.nationality }})</span>
                    </div>
                    <span class="bg-slate-100 text-slate-600 px-3 py-1 rounded-full text-xs font-medium">
                        Książek w bazie: {{ author.books.count }}
                    </span>
                </li>
            {% empty %}
                <li class="p-8 text-center text-slate-500 italic">Brak autorów w bazie danych.</li>
            {% endfor %}
        </ul>
    </div>
</div>
{% endblock %}